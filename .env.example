# Copy this file to .env and fill in your Alpaca paper-trading credentials.
# Never commit .env to source control.
# This repository remains Alpaca paper-trading only.

# ── Alpaca API ─────────────────────────────────────────────────────────────────
ALPACA_API_KEY=your_api_key_here
ALPACA_SECRET_KEY=your_secret_key_here
ALPACA_PAPER=true

# ── Trading mode / safety settings (override watchlist.json defaults) ──────────
PORTFOLIO_SIZE=10000               # Bot risk budget, independent of Alpaca's default paper balance
MAX_POSITION_PERCENT=10            # Max per-symbol allocation as % of PORTFOLIO_SIZE
MAX_DAILY_LOSS_PERCENT=2           # Blocks new BUYs once daily P&L <= -2%
MAX_DAILY_TRADES=3                 # Global executed trade cap per trading day
MAX_TOTAL_EXPOSURE_PERCENT=80      # Blocks new BUYs above this gross exposure
ALLOW_MARGIN=false                 # Must remain false for this project
ALLOW_SHORTS=false                 # Must remain false for this project
MIN_CONFIDENCE=0.70                # AI confidence threshold (0–1)
MAX_RISK_PERCENT=1                 # Max % of account equity risked per trade

# Optional for explicit local reporting/simulation only.
# Fallback/demo prices are never eligible for real paper-order execution.
ALLOW_FALLBACK_DATA=false

# ── Email reporting ────────────────────────────────────────────────────────────
# Gmail: https://myaccount.google.com/apppasswords (generate app password, not your regular password)
# For other providers (Outlook, Yahoo, etc.), use their SMTP settings
SENDER_EMAIL=your-email@gmail.com
SENDER_PASSWORD=your-app-password-here
RECIPIENT_EMAIL=your-email@gmail.com
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
EMAIL_REQUIRED=false
